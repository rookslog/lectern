{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A produced file, content-addressed for idempotence checks.",
      "properties": {
        "path": {
          "pattern": "^(?![A-Za-z]:)(?![\\s\\S]*\\u0000)(?![\\s\\S]*\\\\)(?![\\s\\S]*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ExternalSource": {
      "additionalProperties": false,
      "description": "Allowlisted external identity from local metadata, never download details.",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "playlist_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playlist Id"
        },
        "playlist_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playlist Title"
        },
        "playlist_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playlist Index"
        },
        "language_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language Hint"
        }
      },
      "title": "ExternalSource",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "local"
              }
            }
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "bytes": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "bytes"
            ]
          }
        }
      ],
      "description": "Provenance. `local` sources trigger the privacy hard rule (ADR-0002).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "published": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "external": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "youtube",
        "local",
        "url"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "StageName": {
      "enum": [
        "acquire",
        "normalize",
        "transcribe",
        "diarize",
        "visual",
        "enrich",
        "situate",
        "synthesize"
      ],
      "title": "StageName",
      "type": "string"
    },
    "StageRecord": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/StageState",
          "default": "pending"
        },
        "started": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started"
        },
        "finished": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Outputs",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "StageRecord",
      "type": "object"
    },
    "StageState": {
      "enum": [
        "pending",
        "running",
        "done",
        "failed",
        "skipped"
      ],
      "title": "StageState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "bundle_id": {
      "title": "Bundle Id",
      "type": "string"
    },
    "created": {
      "format": "date-time",
      "title": "Created",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "stages": {
      "additionalProperties": {
        "$ref": "#/$defs/StageRecord"
      },
      "propertyNames": {
        "$ref": "#/$defs/StageName"
      },
      "title": "Stages",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "source"
  ],
  "title": "Manifest",
  "type": "object"
}
